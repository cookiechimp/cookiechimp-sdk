{
  "name": "@cookiechimp/scripts",
  "version": "1.2.0",
  "description": "Opt-in analytics and advertising presets for CookieChimp",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown --config-loader native && for f in index ga4 gtm google-ads meta-pixel clarity posthog segment hotjar linkedin tiktok; do cp dist/$f.d.mts dist/$f.d.ts; done",
    "lint": "biome check .",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cookiechimp/core": "workspace:*",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "@cookiechimp/core": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./ga4": {
      "types": "./dist/ga4.d.ts",
      "import": "./dist/ga4.mjs",
      "require": "./dist/ga4.cjs"
    },
    "./gtm": {
      "types": "./dist/gtm.d.ts",
      "import": "./dist/gtm.mjs",
      "require": "./dist/gtm.cjs"
    },
    "./google-ads": {
      "types": "./dist/google-ads.d.ts",
      "import": "./dist/google-ads.mjs",
      "require": "./dist/google-ads.cjs"
    },
    "./meta-pixel": {
      "types": "./dist/meta-pixel.d.ts",
      "import": "./dist/meta-pixel.mjs",
      "require": "./dist/meta-pixel.cjs"
    },
    "./clarity": {
      "types": "./dist/clarity.d.ts",
      "import": "./dist/clarity.mjs",
      "require": "./dist/clarity.cjs"
    },
    "./posthog": {
      "types": "./dist/posthog.d.ts",
      "import": "./dist/posthog.mjs",
      "require": "./dist/posthog.cjs"
    },
    "./segment": {
      "types": "./dist/segment.d.ts",
      "import": "./dist/segment.mjs",
      "require": "./dist/segment.cjs"
    },
    "./hotjar": {
      "types": "./dist/hotjar.d.ts",
      "import": "./dist/hotjar.mjs",
      "require": "./dist/hotjar.cjs"
    },
    "./linkedin": {
      "types": "./dist/linkedin.d.ts",
      "import": "./dist/linkedin.mjs",
      "require": "./dist/linkedin.cjs"
    },
    "./tiktok": {
      "types": "./dist/tiktok.d.ts",
      "import": "./dist/tiktok.mjs",
      "require": "./dist/tiktok.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookiechimp/cookiechimp-sdk.git",
    "directory": "packages/scripts"
  },
  "homepage": "https://docs.cookiechimp.com/docs/sdk/overview",
  "bugs": {
    "url": "https://github.com/cookiechimp/cookiechimp-sdk/issues"
  }
}
