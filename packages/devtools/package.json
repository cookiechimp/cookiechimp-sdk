{
  "name": "@cookiechimp/devtools",
  "version": "1.0.0",
  "description": "Development panel for inspecting CookieChimp consent state",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown --config-loader native && for f in index simulation; do cp dist/$f.d.mts dist/$f.d.ts; done",
    "lint": "biome check .",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cookiechimp/core": "workspace:*",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "@cookiechimp/core": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./simulation": {
      "types": "./dist/simulation.d.ts",
      "import": "./dist/simulation.mjs",
      "require": "./dist/simulation.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookiechimp/cookiechimp-sdk.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://docs.cookiechimp.com/docs/sdk/overview",
  "bugs": {
    "url": "https://github.com/cookiechimp/cookiechimp-sdk/issues"
  }
}
