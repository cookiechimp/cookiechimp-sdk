{
  "name": "@cookiechimp/tokens",
  "version": "1.2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./css": {
      "types": "./styles.d.ts",
      "default": "./dist/tokens.css"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.mjs",
      "require": "./dist/tailwind.cjs"
    },
    "./json": "./dist/tokens.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "styles.d.ts"
  ],
  "scripts": {
    "build": "tsdown --config-loader native && node scripts/generate.mjs",
    "lint": "biome check .",
    "test:unit": "pnpm build && vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "description": "CookieChimp consent UI design tokens and Tailwind preset",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookiechimp/cookiechimp-sdk.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://docs.cookiechimp.com/docs/sdk/overview",
  "bugs": {
    "url": "https://github.com/cookiechimp/cookiechimp-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
