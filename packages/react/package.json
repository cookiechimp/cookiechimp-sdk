{
  "name": "@cookiechimp/react",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.mjs",
      "require": "./dist/headless.cjs"
    },
    "./banner": {
      "types": "./dist/banner.d.ts",
      "import": "./dist/banner.mjs",
      "require": "./dist/banner.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.cjs"
    },
    "./tcf": {
      "types": "./dist/tcf.d.ts",
      "import": "./dist/tcf.mjs",
      "require": "./dist/tcf.cjs"
    },
    "./styles.css": {
      "types": "./styles.d.ts",
      "default": "./styles.css"
    },
    "./tcf.css": {
      "types": "./styles.d.ts",
      "default": "./tcf.css"
    },
    "./tcf-provider": {
      "types": "./dist/tcf-provider.d.ts",
      "import": "./dist/tcf-provider.mjs",
      "require": "./dist/tcf-provider.cjs"
    }
  },
  "files": [
    "dist",
    "styles.css",
    "tcf.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "styles.d.ts"
  ],
  "scripts": {
    "build": "tsdown --config-loader native && for name in index headless banner ui tcf tcf-provider; do cp dist/$name.d.mts dist/$name.d.ts; done",
    "lint": "biome check .",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cookiechimp/core": "workspace:*",
    "@cookiechimp/tokens": "workspace:*",
    "@cookiechimp/translations": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "description": "Accessible React consent UI and headless hooks for CookieChimp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookiechimp/cookiechimp-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/cookiechimp/cookiechimp-sdk#readme",
  "bugs": {
    "url": "https://github.com/cookiechimp/cookiechimp-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
