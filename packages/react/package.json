{
  "name": "@cookiechimp/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.mjs",
      "require": "./dist/headless.cjs"
    },
    "./banner": {
      "types": "./dist/banner.d.ts",
      "import": "./dist/banner.mjs",
      "require": "./dist/banner.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsdown --config-loader native && for name in index headless banner ui; do cp dist/$name.d.mts dist/$name.d.ts; done",
    "lint": "biome check .",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cookiechimp/core": "workspace:*",
    "@cookiechimp/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
