{
  "name": "@cookiechimp/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.mjs",
      "require": "./dist/gate.cjs"
    },
    "./dynamic": {
      "types": "./dist/dynamic.d.ts",
      "import": "./dist/dynamic.mjs",
      "require": "./dist/dynamic.cjs"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "import": "./dist/network.mjs",
      "require": "./dist/network.cjs"
    },
    "./consent-mode": {
      "types": "./dist/consent-mode.d.ts",
      "import": "./dist/consent-mode.mjs",
      "require": "./dist/consent-mode.cjs"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "import": "./dist/sync.mjs",
      "require": "./dist/sync.cjs"
    },
    "./match": {
      "types": "./dist/match.d.ts",
      "import": "./dist/match.mjs",
      "require": "./dist/match.cjs"
    },
    "./regions": {
      "types": "./dist/regions.d.ts",
      "import": "./dist/regions.mjs",
      "require": "./dist/regions.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native && cp dist/index.d.mts dist/index.d.ts && cp dist/sync.d.mts dist/sync.d.ts && cp dist/match.d.mts dist/match.d.ts && cp dist/regions.d.mts dist/regions.d.ts && cp dist/gate.d.mts dist/gate.d.ts && cp dist/dynamic.d.mts dist/dynamic.d.ts && cp dist/network.d.mts dist/network.d.ts && cp dist/consent-mode.d.mts dist/consent-mode.d.ts",
    "lint": "biome check .",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
