{
  "name": "@cookiechimp/nextjs",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "import": "./dist/pages.mjs",
      "require": "./dist/pages.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.cjs"
    },
    "./styles-route": {
      "types": "./dist/styles-route.d.ts",
      "import": "./dist/styles-route.mjs",
      "require": "./dist/styles-route.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/generate-critical-css.mjs && tsdown --config-loader native && for name in index server pages middleware styles-route; do cp dist/$name.d.mts dist/$name.d.ts; done",
    "lint": "biome check .",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cookiechimp/core": "workspace:*",
    "@cookiechimp/react": "workspace:*",
    "@cookiechimp/tokens": "workspace:*",
    "server-only": "0.0.1"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@cookiechimp/translations": "workspace:*",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
