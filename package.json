{
  "name": "cookiechimp-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "format": "biome format --write .",
    "lint": "biome check . && turbo run lint",
    "size": "pnpm build && node --experimental-strip-types scripts/size-harness.ts",
    "test:component": "pnpm --filter @cookiechimp/tokens --filter @cookiechimp/translations --filter @cookiechimp/core --filter @cookiechimp/react --filter @cookiechimp/nextjs --filter @cookiechimp/scripts --filter @cookiechimp/devtools build && vitest run --config vitest.component.config.ts",
    "test:e2e": "pnpm --filter @cookiechimp/tokens --filter @cookiechimp/translations --filter @cookiechimp/core --filter @cookiechimp/react --filter @cookiechimp/nextjs --filter @cookiechimp/scripts --filter @cookiechimp/devtools --filter @cookiechimp/cli build && pnpm --filter @cookiechimp/fixture-nextjs build && playwright test",
    "test:unit": "turbo run test:unit && vitest run scripts",
    "typecheck": "tsc --noEmit --project tsconfig.tools.json && turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "happy-dom": "21.0.1",
    "rolldown": "1.2.13",
    "tsdown": "0.23.1",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
