{
  "name": "cookiechimp-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "format": "biome format --write .",
    "lint": "biome check . && turbo run lint",
    "size": "pnpm build && size-limit",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:e2e": "pnpm --filter @cookiechimp/fixture-nextjs build && playwright test",
    "test:unit": "turbo run test:unit",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.0",
    "@size-limit/preset-small-lib": "14.2.0",
    "happy-dom": "21.0.1",
    "size-limit": "14.2.0",
    "tsdown": "0.23.1",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
